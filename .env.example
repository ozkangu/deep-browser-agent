# =============================================================================
# Chrome Deep Agent — Environment Configuration
# =============================================================================

# --- LLM Provider (pick one) ---

# Option 1: Direct provider:model format
AGENT_MODEL=anthropic:claude-sonnet-4-20250514

# Option 2: Separate provider and model
# AGENT_MODEL_PROVIDER=anthropic
# AGENT_MODEL_NAME=claude-sonnet-4-20250514

# --- API Keys (set the one matching your provider) ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# GOOGLE_API_KEY=...
# AZURE_OPENAI_API_KEY=...

# --- Provider-specific overrides ---
# AGENT_API_KEY=                       # Override any provider's API key
# AGENT_BASE_URL=                      # Override base URL

# --- OpenRouter specific ---
# AGENT_MODEL=openrouter:anthropic/claude-sonnet-4-20250514
# OPENROUTER_API_KEY=sk-or-...

# --- Ollama specific (local LLM) ---
# AGENT_MODEL=ollama:llama3.3
# OLLAMA_BASE_URL=http://localhost:11434

# --- Azure AI Foundry specific ---
# AGENT_MODEL=azure:gpt-4o
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Google Gemini specific ---
# AGENT_MODEL=google:gemini-2.5-pro
# GOOGLE_API_KEY=...

# --- Chrome DevTools MCP ---
CHROME_HEADLESS=false                   # true = no browser window
CHROME_ISOLATED=true                    # true = temp profile, auto-cleanup
CHROME_SLIM=false                       # true = only 3 tools (navigate, screenshot, eval)
CHROME_VIEWPORT=1920x1080               # viewport size
CHROME_BROWSER_URL=                     # connect to running Chrome (e.g., http://localhost:9222)
CHROME_CHANNEL=                         # stable, canary, beta, dev
